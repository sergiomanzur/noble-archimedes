+    DWORD (*read)(DWORD port, XBOX_INPUT_STATE *state);
+    BOOL (*connected)(DWORD port);
+    DWORD (*capabilities)(DWORD port, DWORD flags, XBOX_INPUT_CAPABILITIES *caps);
+    DWORD (*rumble)(DWORD port, const XBOX_VIBRATION *vibration);
+} XBOX_INPUT_PROVIDER;
