 #include <stdlib.h>
 #include <string.h>
 
+static int provider_active(void);
+
+/* Tables are immutable and outlive in-flight readers (normally static const).
+ * Publish one pointer atomically so shutdown cannot tear callback fields. */
+#if defined(_WIN32)
+static const XBOX_INPUT_PROVIDER *volatile g_provider;
+void xbox_InputSetProvider(const XBOX_INPUT_PROVIDER *provider)
+{
+    if (provider && !provider_active()) provider = NULL;
+    InterlockedExchangePointer((PVOID volatile *)&g_provider, (PVOID)provider);
+}
+static const XBOX_INPUT_PROVIDER *input_provider(void)
+{
+    return (const XBOX_INPUT_PROVIDER *)InterlockedCompareExchangePointer(
+        (PVOID volatile *)&g_provider, NULL, NULL);
+}
+#else
+#include <stdatomic.h>
+static _Atomic(const XBOX_INPUT_PROVIDER *) g_provider;
+void xbox_InputSetProvider(const XBOX_INPUT_PROVIDER *provider)
+{
+    if (provider && !provider_active()) provider = NULL;
+    atomic_store_explicit(&g_provider, provider, memory_order_release);
+}
+static const XBOX_INPUT_PROVIDER *input_provider(void)
+{
+    return atomic_load_explicit(&g_provider, memory_order_acquire);
+}
+#endif
+static int provider_active(void)
+{
+    const char *script = getenv("RECOMP_PAD_SCRIPT");
+    const char *live = getenv("RECOMP_PAD_LIVE");
+    const char *modern = getenv("RECOMP_MODERN_INPUT");
+    return !(script && *script) && !(live && *live) &&
+           !(modern && !strcmp(modern, "0"));
+}
