+     * window in a 128 MB layout, so the add order is not always ascending */
+    for (mirror = 1; mirror < count; mirror++)
+    {
+        struct xbox_guest_window key = windows[mirror];
+        unsigned at = mirror;
+
+        while (at && windows[at - 1].lo > key.lo)
+        {
