+                            (uint64_t)XBOX_GUEST_CONTIG_BASE + contig_size);
+    if (tiled_size)
+        xbox_GuestWindowAdd(windows, &count, capacity, XBOX_TILED_BASE,
+                            (uint64_t)XBOX_TILED_BASE + tiled_size);
+    if (nv2a_size)
+        xbox_GuestWindowAdd(windows, &count, capacity, XBOX_NV2A_BASE,
+                            (uint64_t)XBOX_NV2A_BASE + nv2a_size);
