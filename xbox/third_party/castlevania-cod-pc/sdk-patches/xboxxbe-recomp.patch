 # with the same flags). Expects assets/<xbe> and the config's out = "generated/<game_dir>". At run time the game may be
 # a disc image instead.
+# a little endian 32 bit field of a file
+function(xbe_u32 file offset out)
+    file(READ ${file} hex OFFSET ${offset} LIMIT 4 HEX)
+    string(REGEX REPLACE "(..)(..)(..)(..)" "\\4\\3\\2\\1" hex "${hex}")
+    math(EXPR value "0x${hex}")
+    set(${out} ${value} PARENT_SCOPE)
+endfunction()
